  "scope": {
    "implemented": "bounded, attachment-derived revenue, margin, CAPEX, and free-cash-flow guidance parsing on top of direct SEC filing-detail and PDF extraction",
    "internalEndpoint": "/internal/v1/migration/company-filing-detail-parity/{ticker}",
    "architecture": {
      "domain": "framework-free guidance value, metric, summary, analysis models and pure parsing policy",
      "application": "loads each selected document once, invokes the domain policy, enforces extraction coverage, and projects a parity report",
      "outboundAdapter": "existing bounded SEC HTML, text, and PDF document loader; no parser dependency on HTTP, PDFBox, Jackson, or cache types",
      "inboundAdapter": "additive bounded guidance DTOs; full filing body is never returned",
      "forbiddenOutsideAdapters": [
        "Spring",
        "HTTP client",
        "Jackson",
        "PDFBox",
        "java.io stream",
        "cache implementation"
      ]
    },
    "parsedMetrics": ["revenue", "margin", "capex", "freeCashFlow"],
    "directions": ["mentioned", "raised", "lowered", "affirmed"],
    "stances": ["unclear", "raised", "lowered", "affirmed", "mixed"],
    "valueSupport": {
      "currencies": ["USD", "US$", "$", "EUR", "€"],
      "magnitudes": ["billion", "bn", "million", "mn", "b", "m"],
      "ranges": true,
      "lowerAndUpperBounds": true,
      "percentageAndBasisPointTolerance": true,
      "qualitativeBands": ["low", "mid", "high"]
    },
    "falsePositiveGuards": [
      "historical actuals and movement clauses",
      "deferred revenue",
      "safe-harbor and forward-looking topic enumerations",
      "GAAP and non-GAAP reconciliation or definition text",
      "forecast-versus-actual comparison clauses",
      "historical and guidance comparison tables",
      "free-cash-flow tables and project descriptors"
    ],
    "metricAnchoring": "each metric is parsed from a bounded, position-aware slice so an action or number belonging to a later metric cannot leak backward",
    "remainingInNode": [
      "public company orchestration and route-cache ownership",
      "segment and geography fact enrichment",
      "production filing schedulers and persistence",
      "production score integration and Telegram notifications"
    ],
    "productionTrafficCutover": false,
    "comparableForFinalRuntimeDecision": false
  },
