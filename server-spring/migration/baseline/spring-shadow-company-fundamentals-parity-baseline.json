  "scope": {
    "implementedInternalRead": "GET /internal/v1/migration/company-research-parity/{ticker}",
    "behavior": [
      "legacy company detail remains the serving baseline while Spring independently loads SEC Company Facts and recomputes normalized fundamentals, Company Score, and Buy Score",
      "SEC/XBRL/HTTP/Jackson types remain inside the outbound adapter; application and domain use transport-neutral semantic fact points",
      "the SEC response is parsed token-by-token and only selected us-gaap/dei tags are materialized instead of building a full JsonNode tree",
      "each selected series retains only the newest point, newest four 10-Q points, and newest two 10-K/FY points that the legacy normalizer can observe",
      "successful evidence is bounded to 128 CIKs, fresh for four hours, stale for at most twenty-four hours, and protected by per-CIK single-flight",
      "large SEC fetch/parse work is bounded to two concurrent CIKs by default; malformed and failed responses never replace a successful cache entry",
      "the endpoint is demand-driven and adds no startup fetch, scheduler, persistence write, notification, or Telegram side effect"
    ],
    "remainingInNode": [
      "SEC submissions and ticker-map collection",
      "Yahoo quote collection",
      "analyst consensus collection and history persistence",
      "company detail enrichment and route-cache ownership",
      "company research schedulers and Telegram notifications"
